{
  "name": "video-edit",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "check": "tsc && python3 scripts/check_timeline.py",
    "preview": "remotion render Short out/preview-1080.mp4 --crf=20 && ffmpeg -y -i out/preview-1080.mp4 -vf scale=720:1280 -c:v libx264 -crf 22 -c:a copy out/preview-720.mp4",
    "render": "remotion render Short out/short-1.mp4",
    "thumb": "remotion still ShortThumb out/thumb-short-1.jpg"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.530",
    "@remotion/fonts": "^4.0.530",
    "@remotion/media-utils": "^4.0.530",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.530",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.6.3"
  }
}
